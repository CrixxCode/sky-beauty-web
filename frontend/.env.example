# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL de la API accesible desde el servidor de Next.js (Server Components, rewrites).
# El navegador nunca llama a esta URL directamente: usa /api/v1 a través del proxy de Next.js.
API_INTERNAL_URL=http://localhost:4000
# Clave con la que este servidor se identifica ante la API (igual a INTERNAL_API_KEY del backend).
# Sus peticiones no cuentan para el límite por IP. Obligatoria en producción.
INTERNAL_API_KEY=
