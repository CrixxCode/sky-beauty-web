# URL pública del sitio (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# URL de la API accesible desde el servidor de Next.js (Server Components, rewrites).
# El navegador nunca llama a esta URL directamente: usa /api/v1 a través del proxy de Next.js.
API_INTERNAL_URL=http://localhost:4000
# Hosts permitidos para imágenes (separados por coma): el dominio público del backend, que las sirve.
NEXT_PUBLIC_IMAGE_HOSTS=localhost
