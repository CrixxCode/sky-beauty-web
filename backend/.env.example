# ─── Servidor ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Orígenes permitidos por CORS (separados por coma). Debe incluir la URL pública del frontend.
CORS_ORIGINS=http://localhost:3000

# Dirección pública de la tienda (frontend), sin barra final. Se usa en el enlace de seguimiento
# que recibe el cliente. En producción, el dominio de la tienda.
PUBLIC_SITE_URL=http://localhost:3000
# Nivel de logs: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Número de proxies de confianza delante de la API (para obtener la IP real en el rate limiting).
TRUST_PROXY_HOPS=1

# ─── Base de datos ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sky:change_me_local_only@localhost:5432/sky_beauty?schema=public
# Base de datos aislada para pruebas de integración (nunca apuntar a datos reales).
TEST_DATABASE_URL=postgresql://sky:change_me_local_only@localhost:5432/sky_beauty_test?schema=public

# ─── Autenticación administrativa ───────────────────────────────────────────
# Secreto de firma JWT. Genérelo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Secreto de los enlaces de seguimiento que recibe el cliente (distinto de JWT_SECRET). Si cambia,
# los enlaces ya enviados dejan de funcionar. Mínimo 32 caracteres; se genera igual que JWT_SECRET.
TRACKING_TOKEN_SECRET=
# Clave con la que el servidor de Next.js se identifica ante la API (la misma en frontend/.env).
# Sus peticiones no cuentan para el límite por IP. Obligatoria en producción; mínimo 32 caracteres.
INTERNAL_API_KEY=
# Duración de la sesión administrativa en minutos (8 horas por defecto).
ADMIN_SESSION_TTL_MINUTES=480
# Intentos fallidos antes de bloquear temporalmente una cuenta y duración del bloqueo.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ─── Pedidos ────────────────────────────────────────────────────────────────
# Horas tras las que un pedido "pendiente de confirmación" se cancela y libera stock. 0 = desactivado.
ORDER_PENDING_TTL_HOURS=48
# Horas, desde la confirmación, tras las que un pedido confirmado sin comprobante de pago se cancela y
# libera stock. Solo aplica a métodos que requieren verificación (no a contra entrega). 0 = desactivado.
ORDER_UNPAID_TTL_HOURS=24
# Horas que tiene el cliente para aclarar un pago marcado como rechazado (sin evidencia) antes de que
# la tienda pueda cancelar el pedido.
ORDER_PAYMENT_CLARIFICATION_HOURS=8

# ─── Almacenamiento de imágenes ─────────────────────────────────────────────
# Las imágenes se guardan en el disco del servidor; no se usan servicios de pago (S3, CDN...).
# En producción (Railway) UPLOADS_DIR debe apuntar a la ruta donde se monta el volumen persistente.
# El navegador las pide en /uploads del dominio de la tienda y Next.js las reenvía al backend.
UPLOADS_DIR=./uploads
MAX_IMAGE_SIZE_MB=5

# ─── Datos iniciales (npm run db:seed) ──────────────────────────────────────
# Cuenta de la propietaria. Solo se usa si aún no existe ninguna cuenta ADMIN.
# Después de crearla, borre SEED_OWNER_PASSWORD de su .env.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
# Mínimo 12 caracteres.
SEED_OWNER_PASSWORD=
