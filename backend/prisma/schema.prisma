// Esquema de datos de Sky Beauty Maquillaje.
//
// Convenciones:
// - Identificadores: UUID (estables, no secuenciales, no exponen volumen de negocio).
// - Importes monetarios: Decimal(12, 2) en COP. Nunca punto flotante.
// - Fechas: timestamptz almacenadas en UTC; se presentan en America/Bogota.
// - Los pedidos guardan snapshots (nombre, SKU, precios) para no cambiar al editar el catálogo.
// - Los productos con historial de pedidos se archivan, no se eliminan físicamente.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────── Administración ───────────────────────────────

enum AdminRole {
  /// Propietaria: acceso total. Es la única que crea, desactiva y cambia contraseñas de cuentas del personal.
  ADMIN
  /// Personal: pedidos y envíos (ver, confirmar, editar pedidos sin confirmar, cambiar estado, guías),
  /// inventario y catálogo, y registrar la recepción del comprobante de pago enviado por WhatsApp.
  /// Al marcar como entregado un pedido contra entrega, este queda pagado.
  /// Puede cancelar un pedido SOLO cuando el pago no se pudo demostrar tras darle al cliente
  /// la oportunidad de aclararlo (con motivo obligatorio).
  /// NO puede: verificar/rechazar otros pagos, gestionar promociones, cancelar pedidos en otros casos,
  /// ver costos de compra, gestionar cuentas ni cambiar la configuración. Solo cambia su propia contraseña.
  STAFF
}

model AdminUser {
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique
  name                String
  passwordHash        String
  role                AdminRole      @default(ADMIN)
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?      @db.Timestamptz(3)
  lastLoginAt         DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  sessions            AdminSession[]

  inventoryMovements InventoryMovement[]
  orderStatusChanges OrderStatusHistory[]
  paymentRecords     PaymentRecord[]
  priceChanges       VariantPriceHistory[]
  promotionRevisions PromotionRevision[]
}

/// Sesión administrativa. El JWT solo contiene el id de la sesión; revocarla invalida el token.
model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  userAgent   String?   @db.VarChar(512)
  ipAddress   String?   @db.VarChar(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([adminUserId])
  @@index([expiresAt])
}

// ─────────────────────────────────── Catálogo ──────────────────────────────────

/// Máximo dos niveles: categoría > subcategoría (lo valida la aplicación).
/// Un producto puede ir en una subcategoría o en una categoría que no tenga subcategorías.
model Category {
  id          String     @id @default(uuid()) @db.Uuid
  /// null = categoría de primer nivel.
  parentId    String?    @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  position    Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)

  products   Product[]
  promotions PromotionCategory[]

  @@index([isActive, position])
  @@index([parentId, position])
}

/// Marca de los productos; el catálogo se puede filtrar por marca.
model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  products  Product[]

  @@index([isActive, name])
}

enum ProductStatus {
  DRAFT // en preparación, no visible
  ACTIVE // visible y comprable
  INACTIVE // oculto temporalmente
  ARCHIVED // retirado definitivamente (conserva historial)
}

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String        @unique
  shortDescription String?       @db.VarChar(300)
  description      String
  brandId          String        @db.Uuid
  brand            Brand         @relation(fields: [brandId], references: [id], onDelete: Restrict)
  /// Contenido neto, común a todas las variantes, p. ej. "30 ml" o "4 g".
  netContent       String?       @db.VarChar(50)
  categoryId       String        @db.Uuid
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Precio base en COP. Una variante puede sobrescribirlo.
  basePrice        Decimal       @db.Decimal(12, 2)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  /// Datos de demostración generados por el seed.
  isDemo           Boolean       @default(false)
  publishedAt      DateTime?     @db.Timestamptz(3)
  archivedAt       DateTime?     @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)

  images     ProductImage[]
  variants   ProductVariant[]
  promotions PromotionProduct[]

  @@index([status, categoryId])
  @@index([status, brandId])
  @@index([status, isFeatured])
  @@index([status, publishedAt])
}

model ProductImage {
  id           String          @id @default(uuid()) @db.Uuid
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Variante a la que pertenece la foto (p. ej. el swatch de un tono). null = foto general del producto.
  variantId    String?         @db.Uuid
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// Ruta del archivo relativa a UPLOADS_DIR (disco del servidor).
  storageKey   String
  url          String
  thumbnailKey String
  thumbnailUrl String
  alt          String          @default("")
  width        Int
  height       Int
  sizeBytes    Int
  mimeType     String
  position     Int             @default(0)
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)

  @@index([productId, position])
  @@index([variantId, position])
}

model ProductVariant {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @db.Uuid
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku               String   @unique
  /// Nombre visible de la variante: tono, color, tamaño o presentación.
  name              String
  /// Color de muestra opcional (hex) para tonos.
  colorHex          String?  @db.VarChar(7)
  /// Precio propio de la variante. Si es null se usa Product.basePrice.
  price             Decimal? @db.Decimal(12, 2)
  /// Costo de compra en COP, para márgenes. Solo visible para la propietaria (ADMIN).
  costPrice         Decimal? @db.Decimal(12, 2)
  /// Máximo de unidades de esta variante por pedido. null = sin límite.
  maxPerOrder       Int?
  /// Existencias físicas disponibles para la venta. Solo cambia mediante InventoryMovement.
  stock             Int      @default(0)
  /// Umbral de alerta de stock bajo propio de la variante. Al crearla se propone
  /// StoreSettings.defaultLowStockThreshold. null = sin alerta configurada.
  lowStockThreshold Int?
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  images             ProductImage[]
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  promotions         PromotionVariant[]
  priceHistory       VariantPriceHistory[]

  @@index([productId, position])
}

/// Historial (append-only) del precio de lista efectivo de cada variante
/// (ProductVariant.price o, si es null, Product.basePrice). Se agrega una fila cada vez que cambia,
/// incluido el cambio de Product.basePrice para las variantes sin precio propio.
/// Permite saber el precio vigente en una fecha, p. ej. al editar un pedido con las condiciones
/// del día en que se hizo.
model VariantPriceHistory {
  id          String         @id @default(uuid()) @db.Uuid
  variantId   String         @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price       Decimal        @db.Decimal(12, 2)
  validFrom   DateTime       @default(now()) @db.Timestamptz(3)
  changedById String?        @db.Uuid
  changedBy   AdminUser?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([variantId, validFrom])
}

// ────────────────────────────────── Inventario ─────────────────────────────────

enum InventoryMovementType {
  INITIAL // existencias iniciales de una variante
  PURCHASE // entrada por compra a proveedor
  ADJUSTMENT // ajuste manual (conteo, merma, daño...)
  ORDER_RESERVED // salida al crear un pedido o al agregar unidades al editarlo
  ORDER_RELEASED // entrada al cancelar un pedido no despachado o al quitar unidades al editarlo
  RETURN // entrada por devolución revisada
}

/// Registro inmutable (append-only) de cada cambio de stock.
model InventoryMovement {
  id          String                @id @default(uuid()) @db.Uuid
  variantId   String                @db.Uuid
  variant     ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type        InventoryMovementType
  /// Positivo = entrada, negativo = salida.
  quantity    Int
  stockBefore Int
  stockAfter  Int
  reason      String
  orderId     String?               @db.Uuid
  order       Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdById String?               @db.Uuid
  createdBy   AdminUser?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@index([type, createdAt])
}

// ────────────────────────────────── Promociones ────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromotionScope {
  VARIANT
  PRODUCT
  CATEGORY
}

/// Política (confirmada): las promociones NO se acumulan. Por cada artículo se aplica una sola:
/// 1) gana la de mayor descuento para el cliente, sin importar el alcance (variante, producto o categoría);
/// 2) empate → la creada primero.
/// Una promoción de categoría aplica también a los productos de sus subcategorías.
/// Se puede modificar en cualquier momento; cada cambio genera una PromotionRevision.
model Promotion {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  discountType  DiscountType
  /// Porcentaje (0 < v <= StoreSettings.maxPercentageDiscount) o importe fijo por unidad en COP.
  discountValue Decimal        @db.Decimal(12, 2)
  scope         PromotionScope
  startsAt      DateTime       @db.Timestamptz(3)
  endsAt        DateTime       @db.Timestamptz(3)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)

  variants   PromotionVariant[]
  products   PromotionProduct[]
  categories PromotionCategory[]
  revisions  PromotionRevision[]

  @@index([isActive, startsAt, endsAt])
}

/// Versión (append-only) de una promoción: copia completa de sus condiciones y destinos desde validFrom.
/// Permite evaluar qué promociones estaban vigentes en una fecha, p. ej. al editar un pedido
/// con las condiciones del día en que se hizo.
model PromotionRevision {
  id            String         @id @default(uuid()) @db.Uuid
  promotionId   String         @db.Uuid
  promotion     Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  /// Número consecutivo de versión, empezando en 1.
  revision      Int
  validFrom     DateTime       @default(now()) @db.Timestamptz(3)
  name          String
  discountType  DiscountType
  discountValue Decimal        @db.Decimal(12, 2)
  scope         PromotionScope
  startsAt      DateTime       @db.Timestamptz(3)
  endsAt        DateTime       @db.Timestamptz(3)
  isActive      Boolean
  variantIds    String[]       @db.Uuid
  productIds    String[]       @db.Uuid
  categoryIds   String[]       @db.Uuid
  changedById   String?        @db.Uuid
  changedBy     AdminUser?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([promotionId, revision])
  @@index([promotionId, validFrom])
}

model PromotionVariant {
  promotionId String         @db.Uuid
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variantId   String         @db.Uuid
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([promotionId, variantId])
  @@index([variantId])
}

model PromotionProduct {
  promotionId String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
}

model PromotionCategory {
  promotionId String    @db.Uuid
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String    @db.Uuid
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([promotionId, categoryId])
  @@index([categoryId])
}

// ─────────────────────────────── Clientes y pedidos ─────────────────────────────

/// Cliente identificado por su teléfono (no requiere cuenta).
model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String
  /// Teléfono normalizado en formato E.164 sin "+", p. ej. 573001234567.
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]
}

model PaymentMethod {
  id                   String   @id @default(uuid()) @db.Uuid
  /// Código estable: BANK_TRANSFER, NEQUI, DAVIPLATA, CASH_ON_DELIVERY o personalizados.
  code                 String   @unique
  name                 String
  /// Instrucciones visibles para el cliente (cuenta, titular...). Configurable por la tienda.
  instructions         String?
  /// Si requiere que la tienda verifique manualmente el pago (transferencias).
  requiresVerification Boolean  @default(true)
  /// Si es true, el método solo se ofrece en las ciudades de PaymentMethodCity
  /// (lista vacía = en ninguna). Se usa para el pago contra entrega.
  restrictToCities     Boolean  @default(false)
  /// Total máximo del pedido para ofrecer este método. null = sin máximo.
  maxOrderTotal        Decimal? @db.Decimal(12, 2)
  isActive             Boolean  @default(true)
  position             Int      @default(0)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  orders Order[]
  cities PaymentMethodCity[]
}

/// Municipio donde se ofrece un método de pago restringido (PaymentMethod.restrictToCities).
model PaymentMethodCity {
  id               String        @id @default(uuid()) @db.Uuid
  paymentMethodId  String        @db.Uuid
  paymentMethod    PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Cascade)
  municipalityCode String        @db.Char(5)
  municipality     Municipality  @relation(fields: [municipalityCode], references: [code], onDelete: Restrict)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)

  @@unique([paymentMethodId, municipalityCode])
  @@index([municipalityCode])
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING // aún no se ha recibido el comprobante de pago
  AWAITING_VERIFICATION // el cliente envió el comprobante; la tienda debe verificarlo (no se cancela por plazo)
  PAID // la tienda verificó manualmente el pago
  REJECTED // al verificar no hubo evidencia del pago; el cliente puede aclararlo antes de cancelar
  REFUNDED // el pago fue devuelto al cliente
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  /// Identificador público legible, p. ej. SB-251009-7KQ4M.
  code            String        @unique
  /// Hash SHA-256 del token que permite al cliente consultar su pedido.
  publicTokenHash String
  /// Clave de idempotencia enviada por el cliente + hash de la solicitud original.
  idempotencyKey  String        @unique
  requestHash     String
  customerId      String        @db.Uuid
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          OrderStatus   @default(PENDING_CONFIRMATION)
  paymentStatus   PaymentStatus @default(PENDING)

  // Snapshot de datos de contacto y entrega en el momento del pedido.
  customerName     String
  customerPhone    String
  /// Código DIVIPOLA (DANE) del municipio de entrega.
  municipalityCode String       @db.Char(5)
  municipality     Municipality @relation(fields: [municipalityCode], references: [code], onDelete: Restrict)
  /// Nombres del departamento y municipio en el momento del pedido.
  department       String
  city             String
  addressLine      String
  deliveryNotes    String?

  paymentMethodId   String        @db.Uuid
  paymentMethod     PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  paymentMethodCode String
  paymentMethodName String

  currency      String   @default("COP") @db.VarChar(3)
  /// Suma de precios de lista (sin descuentos).
  subtotal      Decimal  @db.Decimal(12, 2)
  discountTotal Decimal  @db.Decimal(12, 2)
  /// Costo de envío cobrado al cliente. null = por confirmar (se cotiza por WhatsApp);
  /// 0 = envío gratis.
  shippingCost  Decimal? @db.Decimal(12, 2)
  /// subtotal − discountTotal + shippingCost. Mientras el envío esté por confirmar no lo incluye.
  total         Decimal  @db.Decimal(12, 2)

  /// Casilla 1 del checkout: aceptación de los términos y condiciones.
  termsAcceptedAt         DateTime  @db.Timestamptz(3)
  /// Casilla 2 del checkout, separada: autorización del tratamiento de datos personales (Ley 1581 de 2012).
  dataProcessingConsentAt DateTime  @db.Timestamptz(3)
  confirmedAt             DateTime? @db.Timestamptz(3)
  /// Momento en que la tienda marcó el pago como REJECTED. Desde aquí corre el plazo
  /// (ORDER_PAYMENT_CLARIFICATION_HOURS) para que el cliente aclare el pago.
  paymentRejectedAt       DateTime? @db.Timestamptz(3)
  cancelledAt             DateTime? @db.Timestamptz(3)
  /// Obligatorio cuando el pedido está cancelado (también en cancelaciones automáticas).
  cancelReason            String?
  createdAt               DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime  @updatedAt @db.Timestamptz(3)

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  paymentRecords     PaymentRecord[]
  shipping           Shipping?
  inventoryMovements InventoryMovement[]

  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([customerId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @db.Uuid
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String?         @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Snapshots históricos.
  productId      String   @db.Uuid
  productName    String
  productSlug    String
  variantName    String
  sku            String
  unitListPrice  Decimal  @db.Decimal(12, 2)
  unitDiscount   Decimal  @db.Decimal(12, 2)
  unitFinalPrice Decimal  @db.Decimal(12, 2)
  /// Costo de compra de la variante en el momento de la venta. Solo visible para la propietaria.
  unitCost       Decimal? @db.Decimal(12, 2)
  quantity       Int
  lineTotal      Decimal  @db.Decimal(12, 2)
  promotionId    String?  @db.Uuid
  promotionName  String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([orderId])
  @@index([variantId])
}

enum OrderEventType {
  ORDER_STATUS
  /// Cambio en los productos de un pedido sin confirmar (agregar, quitar, cambiar variante o cantidad).
  ITEMS_CHANGED
  PAYMENT_STATUS
  SHIPPING
  NOTE
}

/// Historial de cambios del pedido (estado logístico, pago, envío y notas).
model OrderStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  orderId     String         @db.Uuid
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        OrderEventType @default(ORDER_STATUS)
  fromStatus  String?
  toStatus    String?
  note        String?
  /// null = acción del sistema (creación pública, expiración automática).
  changedById String?        @db.Uuid
  changedBy   AdminUser?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

/// Registro de pagos: cada cambio de estado de pago con su soporte (referencia, importe, nota).
model PaymentRecord {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @db.Uuid
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status       PaymentStatus
  amount       Decimal       @db.Decimal(12, 2)
  /// Referencia de la transferencia, comprobante, etc. (registrada manualmente).
  reference    String?
  note         String?
  recordedById String?       @db.Uuid
  recordedBy   AdminUser?    @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}

// ──────────────────────────────────── Envíos ───────────────────────────────────

model Carrier {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String   @unique
  /// Plantilla opcional de URL de rastreo con {tracking}. No implica seguimiento automático.
  trackingUrlTemplate String?
  phone               String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  shippings Shipping[]
}

/// Cómo se entrega el pedido (decisión del 2026-10-13).
enum ShippingMethod {
  /// Por transportadora: para despachar se registran transportadora y número de guía.
  CARRIER
  /// Entrega local de la tienda (por ejemplo, con mensajero propio): sin transportadora ni guía.
  LOCAL
}

enum ShippingStatus {
  NOT_SHIPPED
  IN_TRANSIT
  DELIVERED
  INCIDENT
}

model Shipping {
  id             String         @id @default(uuid()) @db.Uuid
  orderId        String         @unique @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         ShippingMethod @default(CARRIER)
  carrierId      String?        @db.Uuid
  carrier        Carrier?       @relation(fields: [carrierId], references: [id], onDelete: Restrict)
  trackingNumber String?
  /// Costo real pagado a la transportadora (interno). El cobrado al cliente está en Order.shippingCost.
  carrierCost    Decimal?       @db.Decimal(12, 2)
  status         ShippingStatus @default(NOT_SHIPPED)
  dispatchedAt   DateTime?      @db.Timestamptz(3)
  deliveredAt    DateTime?      @db.Timestamptz(3)
  notes          String?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@index([carrierId])
}

// ──────────────────────────────── Geografía ────────────────────────────────────

/// Departamentos de Colombia según la DIVIPOLA del DANE (incluye Bogotá D.C.).
model Department {
  /// Código DIVIPOLA de 2 dígitos, p. ej. "05" (Antioquia).
  code           String         @id @db.Char(2)
  name           String
  municipalities Municipality[]
}

/// Municipios de Colombia según la DIVIPOLA del DANE.
model Municipality {
  /// Código DIVIPOLA de 5 dígitos; los 2 primeros son el departamento, p. ej. "05001" (Medellín).
  code           String                 @id @db.Char(5)
  departmentCode String                 @db.Char(2)
  department     Department             @relation(fields: [departmentCode], references: [code], onDelete: Restrict)
  name           String
  orders         Order[]
  paymentMethods PaymentMethodCity[]
  shippingRate   MunicipalShippingRate?

  @@index([departmentCode, name])
}

model MunicipalShippingRate {
  id               String       @id @default(uuid()) @db.Uuid
  municipalityCode String       @unique @db.Char(5)
  municipality     Municipality @relation(fields: [municipalityCode], references: [code], onDelete: Restrict)
  amount           Decimal      @db.Decimal(12, 2)
  createdAt        DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @db.Timestamptz(3)

  @@index([amount])
}

// ─────────────────────────────── Configuración ─────────────────────────────────

/// Fila única (id = "default") con la configuración de la tienda.
model StoreSettings {
  id                       String   @id @default("default")
  storeName                String   @default("Sky Beauty Maquillaje")
  tagline                  String?
  /// Número comercial de WhatsApp en formato E.164 sin "+", p. ej. 573001234567.
  whatsappNumber           String?
  contactEmail             String?
  contactPhone             String?
  addressText              String?
  businessHours            String?
  instagramUrl             String?
  facebookUrl              String?
  tiktokUrl                String?
  currency                 String   @default("COP") @db.VarChar(3)
  timezone                 String   @default("America/Bogota")
  nationalFreeShipping     Boolean  @default(false)
  /// Subtotal (después de descuentos) a partir del cual el envío es gratis. null = nunca.
  freeShippingThreshold    Decimal? @db.Decimal(12, 2)
  /// Umbral de stock bajo que se propone al crear una variante. null = no se propone ninguno.
  defaultLowStockThreshold Int?
  /// Máximo permitido para un descuento porcentual. null = aún no configurado (solo aplica el tope de 100 %).
  maxPercentageDiscount    Decimal? @db.Decimal(5, 2)
  heroTitle                String?
  heroSubtitle             String?
  heroImageUrl             String?
  heroCtaLabel             String?
  heroCtaHref              String?
  announcementText         String?
  termsText                String?
  privacyText              String?
  shippingPolicyText       String?
  returnsPolicyText        String?
  /// Muestra un aviso de "tienda de demostración" en todo el sitio.
  demoMode                 Boolean  @default(false)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
}
